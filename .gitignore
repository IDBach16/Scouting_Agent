.env
synergy_token.json
*.log
__pycache__/
*.pyc
*.pt

# Safety backup written by awre_pull.py on every run — regenerates itself,
# and it is a full copy of awre_data.csv so committing it would double the repo.
*.bak
*.tmp

# Future hygiene for a volume-backed CSV. The committed awre_data.csv stays
# tracked (it is the baked-in seed for an empty Railway volume). This line
# does nothing until a later `git rm --cached awre_data.csv`.
awre_data.csv
